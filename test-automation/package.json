{
  "name": "flood-rescue-api-tests",
  "version": "1.0.0",
  "description": "CodeceptJS API Automation Testing for Flood Rescue System (16 APIs)",
  "main": "codecept.conf.js",
  "scripts": {
    "test:api": "npx codeceptjs run --steps",
    "test:report": "npx codeceptjs run --steps --reporter mochawesome",
    "test:team-vehicles": "npx codeceptjs run team_vehicles_test.js --steps",
    "test:assignments": "npx codeceptjs run assignment_dispatch_test.js --steps",
    "test:kcpm8": "npx codeceptjs run upload_notification_report_test.js --steps"
  },
  "devDependencies": {
    "codeceptjs": "^3.6.5",
    "axios": "^1.7.9",
    "mocha": "^10.4.0",
    "mochawesome": "^7.1.3"
  }
}
