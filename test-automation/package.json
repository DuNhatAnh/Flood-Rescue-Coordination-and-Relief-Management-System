{
  "name": "flood-rescue-api-tests",
  "version": "1.0.0",
  "description": "CodeceptJS API Automation Testing for Flood Rescue System (16 APIs)",
  "main": "codecept.conf.js",
  "scripts": {
    "test:api": "npx codeceptjs run --steps",
    "test:report": "npx codeceptjs run --steps --reporter mochawesome",
    "test:citizen": "npx codeceptjs run citizen_portal_test.js --steps",
    "test:epic01": "npx codeceptjs run epic-01-auth/auth_admin_test.js --steps",
    "test:epic02": "npx codeceptjs run epic-02-citizen/citizen_portal_test.js --steps",
    "test:epic03": "npx codeceptjs run epic-03-coordination/assignment_dispatch_test.js --steps",
    "test:epic04": "npx codeceptjs run epic-04-vehicles/team_vehicles_test.js --steps",
    "test:epic05": "npx codeceptjs run epic-05-warehouse/warehouse_distribution_test.js --steps",
    "test:epic06": "npx codeceptjs run epic-06-reports/upload_notification_report_test.js --steps",
    "report:generate": "npx marge output/codeceptjs-report.json -o output -f codeceptjs-report -t \"[KCPM] BÁO CÁO KIỂM THỬ TỰ ĐỘNG HÓA E2E API - CỨU HỘ LŨ LỤT\" -p \"KCPM - E2E API Automation Test Report\" --charts --inline"
  },
  "devDependencies": {
    "codeceptjs": "^3.6.5",
    "axios": "^1.7.9",
    "mocha": "^10.4.0",
    "mochawesome": "^7.1.3"
  }
}
